<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/log_Layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="30dp"
    tools:context=".login">

    <EditText
        android:id="@+id/logUser_Edit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:height="75dp"
        android:hint="@string/logUser_Edit"
        android:importantForAutofill="no"
        android:inputType="text"
        android:padding="30dp"
        android:singleLine="true"
        android:textIsSelectable="true"
        android:textSize="17sp" />

    <EditText
        android:id="@+id/logPass_Edit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:height="75dp"
        android:hint="@string/logPass_Edit"
        android:importantForAutofill="no"
        android:inputType="text|textPassword"
        android:padding="30dp"
        android:singleLine="true"
        android:textIsSelectable="true"
        android:textSize="17sp" />

    <Button
        android:id="@+id/logLogin_Btn"
        android:layout_width="match_parent"
        android:layout_height="85dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="30dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/button_border"
        android:text="@string/logLogin_Btn"
        android:textAllCaps="true"
        android:textSize="25sp" />

    <Button
        android:id="@+id/logReg_Btn"
        android:layout_width="match_parent"
        android:layout_height="85dp"
        android:layout_margin="10dp"
        android:background="@drawable/button_border"
        android:text="@string/logReg_Btn"
        android:textSize="25sp" />

</LinearLayout>