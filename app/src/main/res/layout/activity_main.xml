<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_Layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="30dp"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/mainHeader_Txt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:text="@string/mainHeader_Txt"
        android:textColor="@color/colorPrimaryDark"
        android:textIsSelectable="false"
        android:textSize="30sp" />

    <TextView
        android:id="@+id/mainHeader2_Txt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingBottom="20dp"
        android:text="@string/mainHeader2_Txt"
        android:textColor="@color/colorPrimaryDark"
        android:textIsSelectable="false"
        android:textSize="18sp" />

    <Button
        android:id="@+id/mainTMP_Btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:height="125dp"
        android:background="@drawable/button_border"
        android:text="@string/mainTMP_Btn"
        android:textSize="30sp" />

    <Button
        android:id="@+id/mainBP_Btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:height="125dp"
        android:background="@drawable/button_border"
        android:text="@string/mainBP_Btn"
        android:textSize="30sp" />

    <Button
        android:id="@+id/mainHR_Btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:height="125dp"
        android:background="@drawable/button_border"
        android:text="@string/mainHR_Btn"
        android:textSize="30sp" />

</LinearLayout>